ARG ZLM_COMMIT=2fa539807370c4bcfca9801bde1dd2fdd95ba113
ARG ZLM_IMAGE=zlm-runtime

FROM ubuntu:24.04 AS zlm-builder

ARG ZLM_COMMIT
ARG MODEL=Release

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libssl-dev \
    python3-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/media
RUN git init ZLMediaKit && \
    cd ZLMediaKit && \
    git remote add origin https://github.com/ZLMediaKit/ZLMediaKit.git && \
    git fetch --depth 1 origin "${ZLM_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    git submodule update --init --recursive --depth 1

COPY third_party/zlmediakit/patches/0001-gb28181-tcp-rtcp-rfc4571.patch /tmp/zlm-tcp-rtcp.patch
WORKDIR /opt/media/ZLMediaKit
RUN git apply --check /tmp/zlm-tcp-rtcp.patch && \
    git apply /tmp/zlm-tcp-rtcp.patch

WORKDIR /opt/media/ZLMediaKit/3rdpart
RUN wget -q https://github.com/cisco/libsrtp/archive/v2.3.0.tar.gz -O libsrtp-2.3.0.tar.gz && \
    tar xf libsrtp-2.3.0.tar.gz && \
    mv libsrtp-2.3.0 libsrtp && \
    cd libsrtp && \
    CFLAGS="-fcommon" ./configure --enable-openssl && \
    make -j "$(nproc)" && \
    make install

RUN mkdir -p /opt/media/ZLMediaKit/build /opt/media/ZLMediaKit/release/linux/${MODEL}
WORKDIR /opt/media/ZLMediaKit/build
RUN cmake \
      -DCMAKE_BUILD_TYPE="${MODEL}" \
      -DENABLE_PYTHON=true \
      -DENABLE_WEBRTC=true \
      -DENABLE_FFMPEG=true \
      -DENABLE_TESTS=false \
      -DENABLE_API=false \
      -DENABLE_OBJCOPY=false \
      .. && \
    cmake --build . -j "$(nproc)"

FROM ubuntu:24.04 AS zlm-runtime

ARG MODEL=Release

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    g++ \
    libssl-dev \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    tzdata \
    wget \
    && rm -rf /var/lib/apt/lists/*

ENV TZ=Asia/Shanghai
ENV PATH=/opt/media/bin:$PATH
WORKDIR /opt/media/bin/

RUN mkdir -p /opt/media/bin/www /opt/media/conf /opt/media/default
COPY --from=zlm-builder /opt/media/ZLMediaKit/release/linux/${MODEL}/MediaServer /opt/media/ZLMediaKit/default.pem /opt/media/bin/
COPY --from=zlm-builder /opt/media/ZLMediaKit/release/linux/${MODEL}/config.ini /opt/media/conf/
COPY --from=zlm-builder /opt/media/ZLMediaKit/release/linux/${MODEL}/config.ini /opt/media/default/
COPY --from=zlm-builder /opt/media/ZLMediaKit/www/ /opt/media/bin/www/
COPY scripts/zlm-entrypoint.sh /usr/local/bin/zlm-entrypoint
RUN chmod +x /usr/local/bin/zlm-entrypoint

ENTRYPOINT ["zlm-entrypoint"]
CMD ["./MediaServer", "-s", "default.pem", "-c", "../conf/config.ini", "-l", "0"]

FROM ${ZLM_IMAGE} AS zlm

FROM node:22-alpine AS admin-ui-builder

WORKDIR /src/admin-ui
RUN corepack enable
COPY admin-ui/package.json admin-ui/pnpm-lock.yaml admin-ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY admin-ui/ ./
RUN pnpm build

FROM ubuntu:24.04

ENV TZ=Asia/Shanghai
ENV PYTHONPATH=/opt/media/bin/python
ENV PATH=/opt/media/bin:$PATH
WORKDIR /opt/media/bin/

# 配置 apt 源使用阿里云镜像加速
RUN sed -i 's|http://ports.ubuntu.com/ubuntu-ports|http://mirrors.aliyun.com/ubuntu-ports|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || \
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g; \
            s|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    libssl3 \
    python3 \
    libpython3.12 \
    python3-dev \
    python3-venv \
    python3-pip \
    libstdc++6 \
    libgcc-s1 \
    zlib1g \
    libexpat1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=zlm /opt/media/bin /opt/media/bin
COPY --from=mwader/static-ffmpeg:6.1 /ffmpeg /usr/local/bin/ffmpeg
COPY --from=mwader/static-ffmpeg:6.1 /ffprobe /usr/local/bin/ffprobe

ARG TARGETARCH
ADD ./build/linux_${TARGETARCH}/bin ./gowvp
COPY --from=admin-ui-builder /src/admin-ui/dist ./www

RUN mkdir -p configs python

RUN ln -sf /usr/local/bin/ffmpeg /usr/bin/ffmpeg && \
    ln -sf /usr/local/bin/ffprobe /usr/bin/ffprobe && \
    chmod +x /usr/local/bin/ffmpeg
RUN chmod +x /usr/local/bin/ffprobe

RUN ln -sf /usr/local/bin/ffmpeg /opt/media/bin/ffmpeg && \
    ln -sf /usr/local/bin/ffprobe /opt/media/bin/ffprobe


LABEL Name=gowvp \
      Version=0.1.0 \
      Maintainer="xx@golang.space" \
      Description="gowvp & zlmediakit"

EXPOSE 15123 1935 8080 554 20000-20100/udp 20000-20100

CMD ["./gowvp"]
