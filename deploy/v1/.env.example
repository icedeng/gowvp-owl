# 本地镜像标签；同一套三个镜像使用相同标签。
OWL_IMAGE_TAG=v1-local

# 真机可访问的宿主机局域网地址，不能填写 127.0.0.1 或容器名。
OWL_MEDIA_SDP_IP=CHANGE_ME

# 运行 ./deploy.sh init 时会生成以下高熵随机值。
OWL_MEDIA_SECRET=CHANGE_ME
OWL_ADMIN_USERNAME=admin
OWL_ADMIN_PASSWORD=CHANGE_ME
OWL_JWT_SECRET=CHANGE_ME
OWL_RTMP_SECRET=CHANGE_ME
OWL_WEBHOOK_SECRET=CHANGE_ME

# PostgreSQL 管理员和应用分别使用独立密码。init 自动生成；不复用其他业务数据库。
OWL_POSTGRES_PASSWORD=CHANGE_ME
OWL_POSTGRES_APP_PASSWORD=CHANGE_ME
OWL_DATABASE_DSN=postgres://gowvp:CHANGE_ME@postgres:5432/gowvp?sslmode=disable&TimeZone=Asia/Shanghai

# 可选：启用 SIP Digest 时与设备端保持一致。
OWL_SIP_PASSWORD=

# 宿主机端口。
OWL_HTTP_PORT=15123
OWL_ZLM_HTTP_PORT=8080
