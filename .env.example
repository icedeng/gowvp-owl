# 生产部署时复制为 .env，并为每项生成独立的高熵随机值。
OWL_ADMIN_USERNAME=admin
OWL_ADMIN_PASSWORD=replace-with-a-random-password
OWL_JWT_SECRET=replace-with-at-least-32-random-bytes
OWL_RTMP_SECRET=replace-with-at-least-32-random-bytes
OWL_MEDIA_SECRET=replace-and-sync-with-zlm-api-secret
OWL_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# 可选；启用 SIP Digest 时与设备端保持一致。
OWL_SIP_PASSWORD=
