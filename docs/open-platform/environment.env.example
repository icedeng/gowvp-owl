# 默认关闭；生产值由Secret或服务管理器注入，勿提交真实凭据。
OWL_OPEN_PLATFORM_ENABLED=false
# 显式允许HTTP入口、密钥一次性响应及HTTP回调；默认false。
OWL_OPEN_PLATFORM_ALLOW_HTTP=false
OWL_OPEN_PLATFORM_AUDIENCE=owl-production
OWL_OPEN_PLATFORM_PUBLIC_URL=https://open.example.com
OWL_OPEN_PLATFORM_KEY_ID=v1
# 密钥文件JSON形如 {"v1":"<32随机字节的Base64URL无填充编码>"}
OWL_OPEN_PLATFORM_KEYS_FILE=/run/secrets/owl-open-platform-keyring.json
# 二选一：OWL_OPEN_PLATFORM_KEYS 注入上述JSON；文件配置优先。
OWL_OPEN_PLATFORM_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 按实际管理网络填写，不允许回调进入；示例不是完整网络清单。
OWL_OPEN_PLATFORM_CALLBACK_DENY_CIDRS=10.0.0.0/24,192.168.1.0/24
# OWL_DATABASE_DSN 与原Owl运行配置一致，通过Secret注入；迁移工具需要显式设置。
